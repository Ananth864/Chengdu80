{
  "name": "web-starter",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.1.13",
      "typescript": "^6",
      "lucide-react": "^1.21.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.1",
      "convex": "^1.42.0",
      "@workos/authkit-tanstack-react-start": "^0.11.0",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "alchemy": "2.0.0-beta.81",
      "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.1",
      "vite-plus": "1.0.0-rc.1",
      "effect": "^4.0.2",
      "@clerk/tanstack-react-start": "^1.7.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "dev:web": "vp run --filter web dev",
    "dev:server": "vp run --filter @web-starter/backend dev",
    "dev:setup": "vp run --filter @web-starter/backend dev:setup",
    "codegen": "vp run --filter @web-starter/backend codegen",
    "build": "vp run -r build",
    "check": "vp check",
    "fix": "vp check --fix",
    "deploy": "vp run --filter web deploy",
    "destroy": "vp run --filter web destroy",
    "init": "bun scripts/init.ts"
  },
  "dependencies": {
    "@web-starter/env": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260621.1",
    "@types/node": "^22.13.14",
    "@web-starter/config": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "packageManager": "bun@1.3.13"
}
