{
  "name": "web-starter",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "lucide-react": "^1.21.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.1",
      "convex": "^1.42.0",
      "@workos/authkit-tanstack-react-start": "^0.11.0",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "alchemy": "^0.91.2"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F @web-starter/backend",
    "dev:setup": "turbo run dev:setup -F @web-starter/backend",
    "codegen": "turbo run codegen -F @web-starter/backend",
    "deploy": "turbo run deploy -F @web-starter/infra",
    "destroy": "turbo run destroy -F @web-starter/infra",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "@web-starter/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260621.1",
    "@types/node": "^22.13.14",
    "@web-starter/config": "workspace:*",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "turbo": "^2.10.2",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.13"
}
