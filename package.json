{
  "name": "web-starter",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "apps/web/starter/project"
    ],
    "catalog": {
      "zod": "^4.1.13",
      "typescript": "^6",
      "lucide-react": "^1.21.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.1",
      "convex": "^1.42.0",
      "@workos/authkit-tanstack-react-start": "^0.11.0",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.1",
      "vite-plus": "1.0.0-rc.1"
    }
  },
  "type": "module",
  "scripts": {
    "workflow": "bun scripts/workflow.ts",
    "dev:local": "bun scripts/dev-local.ts",
    "credentials": "bun scripts/credentials.ts",
    "setup:env": "bun scripts/setup-env.ts",
    "dev:hosted": "bun scripts/hosted.ts dev",
    "deploy:hosted": "bun scripts/hosted.ts deploy",
    "test:prototype": "bun scripts/test-prototype.ts",
    "test:flow": "bun scripts/test-flow.ts",
    "test:model-contract": "bun scripts/test-model-contract.ts",
    "examples": "bun scripts/export-examples.ts",
    "seed:flagships": "bun scripts/seed-flagships.ts",
    "dev": "vp run -r --parallel dev",
    "dev:web": "vp run --filter web dev",
    "dev:server": "vp run --filter @web-starter/backend dev",
    "dev:setup": "vp run --filter @web-starter/backend dev:setup",
    "codegen": "bun scripts/convex.ts codegen",
    "build": "vp run -r build",
    "check": "vp check",
    "fix": "vp check --fix",
    "docker:build": "docker build -t chengdu80-web -f apps/web/Dockerfile .",
    "setup:selfhosted": "bash scripts/setup-selfhosted.sh",
    "test:demo": "bun scripts/test-demo.ts",
    "test:glm-contract": "bun scripts/test-glm-contract.ts",
    "test:query-stream": "bun --conditions=development scripts/test-query-stream.ts",
    "deploy:backend": "bun scripts/convex.ts push",
    "test:ui": "VITE_LOCAL_MODE=1 bun run build && bun scripts/test-ui.ts",
    "test:build-policy": "bun scripts/test-build-policy.ts",
    "test:company-lookup": "bun scripts/test-company-lookup.ts",
    "test:agent": "VITE_LOCAL_MODE=1 bun run build && bun scripts/test-agent.ts",
    "test:plugins": "VITE_LOCAL_MODE=1 bun run build && bun scripts/test-plugins.ts",
    "test:company-capabilities": "bun scripts/test-company-capabilities.ts",
    "test:risk-profile": "bun scripts/test-risk-profile.ts",
    "test:risk-profile-integration": "bun scripts/test-risk-profile-integration.ts",
    "test:risk-questionnaire-ui": "bun scripts/test-risk-questionnaire-ui.ts",
    "test:company-discovery": "bun scripts/test-company-discovery.ts",
    "test:company-universe": "bun scripts/test-company-universe.ts",
    "test:company-discovery-integration": "bun scripts/test-company-discovery-integration.ts",
    "test:company-discovery-ui": "bun scripts/test-company-discovery-ui.ts",
    "test:industry-preference": "bun scripts/test-industry-preference.ts",
    "test:industry-preference-ui": "bun scripts/test-industry-preference-ui.ts",
    "test:industry-preference-integration": "bun scripts/test-industry-preference-integration.ts",
    "test:tushare": "bun scripts/test-tushare.ts",
    "verify:financial-data": "bun scripts/verify-financial-data.ts",
    "test:historical-analysis": "bun scripts/test-historical-analysis.ts",
    "test:industry-research": "bun scripts/test-industry-research.ts",
    "test:price-target": "bun scripts/test-price-target.ts",
    "test:discovery-contract": "bun scripts/test-discovery-contract.ts",
    "test:financial-capabilities-integration": "bun scripts/test-financial-capabilities-integration.ts",
    "test:financial-analysis-ui": "bun scripts/test-financial-analysis-ui.ts",
    "test:financial-request": "bun scripts/test-financial-request.ts",
    "test:requirements": "bun scripts/test-requirements.ts",
    "test:conversation": "bun scripts/test-conversation.ts",
    "starter:sync": "bun scripts/sync-app-starter.ts",
    "test:chat-storage": "bun scripts/test-chat-storage.ts",
    "test:financial-starter": "bun scripts/test-financial-starter.ts",
    "dev:isolated": "bun scripts/dev-isolated.ts",
    "provider": "bun scripts/set-provider.ts",
    "dev:glm": "bun scripts/set-provider.ts glm && bun run dev:local",
    "dev:openai": "bun scripts/set-provider.ts openai && bun run dev:local",
    "dev:fast": "bun scripts/dev-fast.ts"
  },
  "dependencies": {
    "@web-starter/env": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@web-starter/config": "workspace:*",
    "convex": "catalog:",
    "playwright": "^1.64.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "packageManager": "bun@1.3.13",
  "patchedDependencies": {
    "@tanstack/router-ssr-query-core@1.169.1": "patches/@tanstack%2Frouter-ssr-query-core@1.169.1.patch"
  }
}
