# User-selected main model. Use the base URL for the site that issued the key.
MODEL_PROVIDER=glm
GLM_API_KEY=
GLM_MODEL=GLM-5.3
# Current provider: Gitee AI, OpenAI-compatible Chat Completions.
GLM_BASE_URL=https://ai.gitee.com/v1

# Hosted prototype launchers default to a shared workspace without login.
CD80_DEMO_MODE=1
# Set CD80_DEMO_MODE=1 in the Convex deployment too. WorkOS is deferred.
# Prefer workspace ../.env with the prototype launchers; no secrets in VITE_ variables.
VITE_CONVEX_URL=
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=http://localhost:3001/api/auth/callback
WORKOS_COOKIE_PASSWORD=
PLATFORM_INTERNAL_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
TUSHARE_TOKEN=

# Optional registered OpenAPI plugin credentials. Names must start CD80_PLUGIN_.
# Enter only the variable name in Connections; credentials stay on the server.
# Example: CD80_PLUGIN_WEATHER_KEY= (set privately in your local/server environment).
